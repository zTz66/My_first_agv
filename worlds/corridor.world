<?xml version="1.0" ?>
<!--
  Z 形走廊导航仿真世界
  
  走廊中心线（折线）：
  - 段1：(-5, 0) → (-2, 0)    沿 +X
  - 段2：(-2, 0) → (-2, -3)   右转 90°
  - 段3：(-2, -3) → (1, -3)   左转 90°
  
  走廊结构：
  - 走廊宽度：1.5m（半宽 0.75）
  - 墙厚：0.15m，墙高：0.5m
  - 6 面墙：每段 2 面侧墙（拐角填充墙已删，相邻侧墙在拐角处直接连接成直角）
  - 段2西侧墙顶部缩到 y=-0.75、段1南墙东端缩到 x=-2.75，去掉伸进对方走廊的交叉延伸
  - 拐角1：段1北墙东延到 x=-1.1、段2东墙顶延到 y=0.9，连接成东北外角
  - 拐角2：段2西墙底延到 y=-3.9、段3南墙西延到 x=-2.9，连接成西南外角
-->
<sdf version="1.5">
  <world name="corridor_world">
    <physics type="ode">
      <real_time_update_rate>1000.0</real_time_update_rate>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <ode>
        <solver>
          <type>quick</type>
          <iters>150</iters>
          <precon_iters>0</precon_iters>
          <sor>1.400000</sor>
          <use_dynamic_moi_rescaling>1</use_dynamic_moi_rescaling>
        </solver>
      </ode>
    </physics>
    
    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>true</shadows>
    </scene>
    
    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 -0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>
    
    <!-- 地面 -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>100</mu>
                <mu2>50</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Grey</name>
            </script>
          </material>
        </visual>
      </link>
    </model>
    
    <!-- ============================================ -->
    <!-- Z 形走廊墙体（6 面墙） -->
    <!-- 段1（水平，y=0，x∈[-5,-2]） -->
    <!-- ============================================ -->
    <model name="seg1_bottom_wall">
      <static>true</static>
      <!-- 东端从 x=-2 缩到 x=-2.75（与段2西墙东侧齐平）：去掉伸进走廊2的延伸 -->
      <pose>-3.875 -0.825 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>2.25 0.15 0.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>2.25 0.15 0.5</size></box></geometry>
          <material>
            <ambient>0.6 0.6 0.6 1</ambient>
            <diffuse>0.6 0.6 0.6 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    
    <model name="seg1_top_wall">
      <static>true</static>
      <!-- 东端从 x=-2 延到 x=-1.1（与段2东墙连接），封闭拐角1东北外角 -->
      <pose>-3.05 0.825 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>3.9 0.15 0.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>3.9 0.15 0.5</size></box></geometry>
          <material>
            <ambient>0.6 0.6 0.6 1</ambient>
            <diffuse>0.6 0.6 0.6 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    
    <!-- ============================================ -->
    <!-- 段2（垂直，x=-2，y∈[-3,0]） -->
    <!-- 西侧墙顶部缩到 y=-0.75（与段1南墙齐平）、底部延到 y=-3.9（与段3南墙连接，封闭拐角2西南外角） -->
    <!-- ============================================ -->
    <model name="seg2_left_wall">
      <static>true</static>
      <pose>-2.825 -2.325 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.15 3.15 0.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.15 3.15 0.5</size></box></geometry>
          <material>
            <ambient>0.6 0.6 0.6 1</ambient>
            <diffuse>0.6 0.6 0.6 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    
    <model name="seg2_right_wall">
      <static>true</static>
      <!-- 段2东侧墙（x∈[-1.25,-1.1]，y∈[-2.25,0.9]）：底部缩到 y=-2.25 让出走廊3入口，顶部延到 y=0.9 与段1北墙连接（封闭拐角1东北外角） -->
      <pose>-1.175 -0.675 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.15 3.15 0.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.15 3.15 0.5</size></box></geometry>
          <material>
            <ambient>0.6 0.6 0.6 1</ambient>
            <diffuse>0.6 0.6 0.6 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    
    <!-- ============================================ -->
    <!-- 段3（水平，y=-3，x∈[-2,1]） -->
    <!-- ============================================ -->
    <model name="seg3_bottom_wall">
      <static>true</static>
      <!-- 西端从 x=-2 延到 x=-2.9（与段2西墙连接），封闭拐角2西南外角 -->
      <pose>-0.95 -3.825 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>3.9 0.15 0.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>3.9 0.15 0.5</size></box></geometry>
          <material>
            <ambient>0.6 0.6 0.6 1</ambient>
            <diffuse>0.6 0.6 0.6 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    
    <model name="seg3_top_wall">
      <static>true</static>
      <pose>0.0 -2.175 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>2.0 0.15 0.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>2.0 0.15 0.5</size></box></geometry>
          <material>
            <ambient>0.6 0.6 0.6 1</ambient>
            <diffuse>0.6 0.6 0.6 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    
    <!-- ============================================ -->
    <!-- 可移动障碍物（盒子） -->
    <!-- 初始位置：段3中间 (0, -3) -->
    <!-- ============================================ -->
    <model name="obstacle_box">
      <pose>0.0 -3.0 0.15 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>1.0</mass>
          <inertia>
            <ixx>0.001</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>0.001</iyy>
            <iyz>0</iyz>
            <izz>0.001</izz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry>
            <box>
              <size>0.3 0.3 0.3</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.3 0.3 0.3</size>
            </box>
          </geometry>
          <material>
            <ambient>0.8 0.2 0.2 1</ambient>
            <diffuse>0.8 0.2 0.2 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    
  </world>
</sdf>
