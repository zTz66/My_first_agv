<?xml version="1.0" ?>
<!--
  走廊导航仿真世界
  
  本文件定义了一个 1.5 米宽的虚拟走廊环境，用于测试受限走廊导航系统。
  
  走廊结构（沿 Y 轴方向）：
  - 走廊中心线：x = 0，从 y = -2 到 y = 8
  - 走廊宽度：1.5 米（两侧墙壁间距）
  - 左墙：x = -0.825
  - 右墙：x = +0.825
  - 墙壁高度：0.5 米
  - 墙壁厚度：0.15 米
  
  障碍物：
  - 一个可移动的盒子，初始位置在走廊中间 (0, 3)
-->
<sdf version="1.5">
  <world name="corridor_world">
    <!-- 物理引擎配置 -->
    <physics type="ode">
      <real_time_update_rate>1000.0</real_time_update_rate>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <ode>
        <solver>
          <type>quick</type>
          <iters>150</iters>
          <precon_iters>0</precon_iters>
          <sor>1.400000</sor>
          <use_dynamic_moi_rescaling>1</use_dynamic_moi_rescaling>
        </solver>
      </ode>
    </physics>
    
    <!-- 场景配置 -->
    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>true</shadows>
    </scene>
    
    <!-- 光照 -->
    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 -0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>
    
    <!-- 地面 -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>100</mu>
                <mu2>50</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Grey</name>
            </script>
          </material>
        </visual>
      </link>
    </model>
    
    <!-- ============================================ -->
    <!-- 走廊左墙（沿 Y 轴方向） -->
    <!-- 位置：x = -0.825（墙中心） -->
    <!-- 尺寸：宽 0.15m，长 10m，高 0.5m -->
    <!-- ============================================ -->
    <model name="corridor_left_wall">
      <static>true</static>
      <pose>-0.825 3.0 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.15 10.0 0.5</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.15 10.0 0.5</size>
            </box>
          </geometry>
          <material>
            <ambient>0.6 0.6 0.6 1</ambient>
            <diffuse>0.6 0.6 0.6 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    
    <!-- ============================================ -->
    <!-- 走廊右墙（沿 Y 轴方向） -->
    <!-- 位置：x = 0.825（墙中心） -->
    <!-- 尺寸：宽 0.15m，长 10m，高 0.5m -->
    <!-- ============================================ -->
    <model name="corridor_right_wall">
      <static>true</static>
      <pose>0.825 3.0 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.15 10.0 0.5</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.15 10.0 0.5</size>
            </box>
          </geometry>
          <material>
            <ambient>0.6 0.6 0.6 1</ambient>
            <diffuse>0.6 0.6 0.6 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    
    <!-- ============================================ -->
    <!-- 可移动障碍物（盒子） -->
    <!-- 初始位置：走廊中间 (0, 3) -->
    <!-- 尺寸：0.3m x 0.3m x 0.3m -->
    <!-- 可以通过 Gazebo GUI 手动移动 -->
    <!-- ============================================ -->
    <model name="obstacle_box">
      <pose>0.0 3.0 0.15 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>1.0</mass>
          <inertia>
            <ixx>0.001</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>0.001</iyy>
            <iyz>0</iyz>
            <izz>0.001</izz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry>
            <box>
              <size>0.3 0.3 0.3</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.3 0.3 0.3</size>
            </box>
          </geometry>
          <material>
            <ambient>0.8 0.2 0.2 1</ambient>
            <diffuse>0.8 0.2 0.2 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    
  </world>
</sdf>
